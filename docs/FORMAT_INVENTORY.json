{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM-CLOFuzz Format Inventory",
  "version": "1.0.0",
  "contracts": {
    "replay_container": {
      "header_width_bytes": 4,
      "endianness": "host_little_endian",
      "record_header_type": "uint32_t",
      "payload_binary_safe": true,
      "null_terminated": false,
      "zero_length_allowed": true,
      "zero_length_interval": "end = start - 1",
      "trailing_data_allowed": false,
      "size_formula": "sum(4 + record_len_i)"
    },
    "raw_buffer": {
      "framing": "none",
      "explicit_length_required": true,
      "null_terminated": false,
      "multi_message_invertible_without_metadata": false
    },
    "region_metadata": {
      "type": "region_t",
      "coordinate_system": "closed_interval",
      "start_field": "start_byte",
      "end_field": "end_byte",
      "bounds_formula": "end_byte == start_byte + len - 1",
      "buffer_association_required": true,
      "invalidation_triggers": [
        "buffer_realloc",
        "content_mutation",
        "length_change",
        "iteration_completion"
      ]
    }
  },
